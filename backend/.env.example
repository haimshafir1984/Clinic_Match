# ShiftMatch Backend Environment Variables Example
# Copy this file to '.env' and fill in your values.

# The port the backend will run on locally
PORT=10000

# Allowed origin for CORS (your frontend local URL)
ALLOWED_ORIGIN=http://localhost:5173

# Your PostgreSQL connection string. 
# Since you are using Supabase, you can find this in your Supabase Dashboard under:
# Settings -> Database -> Connection String (URI format).
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.ctqknkzgtkwxmsskwoqe.supabase.co:5432/postgres
DATABASE_URL=your_postgresql_connection_string

# A secret string used to sign JWT authentication tokens.
# Change this to any secure random string.
JWT_SECRET=super_secret_jwt_token_key_123!

# OpenAI API Key for AI profile parsing & screening (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# RapidAPI JSearch Key for importing external jobs (Optional)
JSEARCH_API_KEY=your_jsearch_api_key_here

# Enable Indeed job scraping via Puppeteer MCP (true/false)
ENABLE_PUPPETEER_SCRAPING=false

# --- Auth ---

# The one account that logs in with a password instead of an email OTP code.
# Defaults to haim.shafir.1@gmail.com if not set.
ADMIN_EMAIL=haim.shafir.1@gmail.com

# Set this to (re)issue the admin password on the next server boot. The
# server hashes it and stores the hash, then you should remove/rotate this
# env var (it re-applies the password on every restart while it's set).
ADMIN_BOOTSTRAP_PASSWORD=choose_a_strong_password_here

# --- Email (used to send OTP login/registration codes) ---
# If neither is set, OTP codes are logged to the server console instead of
# emailed — fine for local development, not for production.

# Preferred on Render: raw SMTP ports (25/465/587) are blocked outbound on
# Render's free tier, so Resend's HTTPS API is the one that actually works
# there. Get a free key at https://resend.com — no domain verification
# needed if you send from the sandbox address below.
RESEND_API_KEY=
RESEND_FROM=ShiftMatch <onboarding@resend.dev>

# Fallback / used when RESEND_API_KEY is not set. Only works if outbound
# SMTP isn't blocked on your host (e.g. a paid Render instance, or most
# other hosts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
